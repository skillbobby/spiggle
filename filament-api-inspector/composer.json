{
    "name": "spiggle/filament-api-inspector",
    "description": "Capture, inspect, filter and replay every API request hitting your Filament panel or Laravel app — with live updates and a beautiful inspector UI.",
    "keywords": [
        "filament",
        "laravel",
        "api",
        "inspector",
        "debug",
        "http",
        "replay"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0|^5.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Spiggle\\ApiInspector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spiggle\\ApiInspector\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Spiggle\\ApiInspector\\ApiInspectorServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
